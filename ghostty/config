gtk-tabs-location = hidden
window-decoration = true
window-theme = ghostty
gtk-titlebar = true
gtk-titlebar-style = tabs
gtk-wide-tabs=true
gtk-toolbar-style=flat
bell-features = audio,attention,title
bell-audio-path = /usr/share/sounds/gnome/default/alerts/click.ogg
shell-integration = detect
shell-integration-features = cursor,sudo,title
bell-audio-volume = 1 
maximize=true
copy-on-select=clipboard
right-click-action=copy-or-paste

keybind = ctrl+shift+space=toggle_quick_terminal
quick-terminal-position = top

# Fuentes
font-family = AdwaitaMono Nerd Font
font-family-italic = AdwaitaMono Nerd Font
font-family-bold = AdwaitaMono Nerd Font
font-family-bold-italic = AdwaitaMono Nerd Font
font-size = 16

# Configuración de ventana - TAMAÑO FIJO
window-padding-x= 10
window-padding-y= 10
window-save-state = always
window-width = 100
window-height = 30


### Mac Alt Fix
macos-option-as-alt = left
keybind = alt+left=unbind
keybind = alt+right=unbind
quick-terminal-position = top

### KeyBindings
# Split Management
keybind = alt+v=new_split:right
keybind = alt+d=new_split:down
keybind = alt+q=close_surface

# Resize Split
keybind = alt+j=resize_split:up,10
keybind = alt+k=resize_split:down,10
keybind = alt+h=resize_split:left,10
keybind = alt+l=resize_split:right,10

# Navigation
keybind = alt+k=goto_split:up
keybind = alt+j=goto_split:down
keybind = alt+h=goto_split:left
keybind = alt+l=goto_split:right
keybind = ctrl+tab=next_tab

# Miscellaneous
keybind = cmd+k=clear_screen
keybind = alt+s=write_screen_file:paste

# Tema y cursor
cursor-style = block
theme = kanagawa-wave.conf
